        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 16,
      "title": "Operator audit trail",
      "type": "logs",
      "description": "Actual operator operations with server-generated correlation IDs. Submitted bodies and credentials are excluded by the event contract.",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "p10-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "p10-loki"
          },
          "expr": "{job=\"p10-security\",source=\"operator\",provenance=\"live-lab\"} | json | __error__=\"\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
