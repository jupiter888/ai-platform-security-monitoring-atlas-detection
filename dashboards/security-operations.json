          },
          "expr": "sum by (reason) (count_over_time({job=\"p10-security\",source=\"operator\",provenance=\"live-lab\"} | json | __error__=\"\" [1m]))",
          "queryType": "range",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
